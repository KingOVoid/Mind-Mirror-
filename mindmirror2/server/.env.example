# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mindmirror?schema=public"

# Secret used to sign JWT session tokens. Use a long, random string in production.
JWT_SECRET="change_this_to_a_long_random_string_in_production"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# The frontend origin allowed by CORS.
CLIENT_URL="http://localhost:5173"

# Optional: set these to enable AI-powered features (answer explanations,
# study plans, weak-topic summaries). The app works fully without them —
# every AI feature has a rule-based fallback. The key is read only on the
# server and is never sent to the browser.
AI_API_KEY=""
AI_PROVIDER="none"
